{
  "protocol": "vmess",
  "settings": {
    "vnext": [
      {
        "address": "{{.Address}}",
        "port": {{.Port}},
        "users": [
          {
            "id": "{{.ID}}",
            "alterId": {{.AlterID}},
            "security": "auto",
            "level": 0
          }
        ]
      }
    ]
  },
  "streamSettings": {
    "network": "{{.Network}}",
    "security": "{{.StreamSecurity}}",
    {{- if eq .StreamSecurity "tls" }}
    "tlsSettings": {
      "serverName": "{{.Sni}}",
      "allowInsecure": {{.AllowInsecure}},
      "fingerprint": "{{.Fingerprint}}"
    },
    {{- end }}
    {{- if eq .Network "ws" }}
    "wsSettings": {
      "path": "{{.Path}}",
      "headers": {
        "Host": "{{.Host}}"
      }
    },
    {{- end }}
    {{- if eq .Network "grpc" }}
    "grpcSettings": {
      "serviceName": "{{.Path}}"
    },
    {{- end }}
    "sockopt": {
      "mark": 255,
      "tcpFastOpen": true
    }
  },
  "tag": "outBound_PROXY"
}